{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "riftwalker",
  "version": "0.1.0",
  "identifier": "dev.riftwalker.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Riftwalker",
        "width": 1920,
        "height": 40,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false
      },
      {
        "label": "theme-picker",
        "title": "Riftwalker chrome selector",
        "decorations": false,
        "visible": false,
        "transparent": true,
        "resizable": false,
        "center": true,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
